{
  "name": "pi-wsl-desktop",
  "version": "1.0.0-rc.1",
  "description": "Lightweight Windows desktop client for the existing Pi coding agent inside WSL. M4 R01: reproducible Windows release packaging.",
  "license": "MIT",
  "private": true,
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:ui": "vitest run --project ui",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:smoke:real": "REAL_WSL=1 vitest run --project smoke",
    "build": "node scripts/build.mjs",
    "design": "vite --config design-lab/vite.config.ts",
    "start": "npm run build && electron .",
    "prestart": "node scripts/check-electron-dist.mjs",
    "start:win": "npm run build && node scripts/start-win.mjs",
    "smoke:win:gui": "node scripts/win-gui-smoke.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "io.pi-desktop.wsl",
    "productName": "Pi WSL Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!node_modules/**"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "dist/bridge/index.cjs",
        "to": "bridge/index.cjs"
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "artifactName": "PiWSLDesktop-${version}-setup.${ext}",
      "shortcutName": "Pi WSL Desktop",
      "uninstallDisplayName": "Pi WSL Desktop",
      "runAfterFinish": false,
      "include": "nsis-guard.nsh"
    }
  }
}

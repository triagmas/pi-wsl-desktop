#!/usr/bin/env node
/**
 * Deterministic Pi RPC fixture — mirrors the installed Pi 1.3.0 protocol
 * (JSONL stdin commands / stdout responses + session events, LF framing,
 * id correlation, agent_settled terminal, abort-waits-idle).
 *
 * Behaviour via FAKE_PI_MODE:
 *   ok (default)      stream a prompt to agent_settled (unicode deltas)
 *   handled           prompt answers disposition=handled (no run, no settled)
 *   hang-prompt       never answer the prompt (deadline/kill tests)
 *   crash-on-prompt   exit(7) mid-run after two records
 *   switch-fail       switch_session answers success:false
 *   ext-ui            emit a fire-and-forget + a blocking dialog at startup
 *   hostile-start     emit garbage + an oversize line before anything else
 * FAKE_PI_STREAM_MS delays each stream step (slow runs for interrupt tests).
 */
'use strict';

// Probe compatibility (mirror of the REAL pi CLI surface used by probePi):
// `pi --version` and `pi --help` answer and exit; any other argv (notably
// `--mode rpc --session …`) enters the RPC loop below.
if (process.argv.includes('--version')) {
  process.stdout.write('1.3.0-fake\n');
  process.exit(0);
}
if (process.argv.includes('--help')) {
  process.stdout.write('Usage: pi\n  --mode <mode>   Output mode: text (default), json, or rpc\n');
  process.exit(0);
}

const MODE = process.env.FAKE_PI_MODE || 'ok';
const STREAM_MS = Number(process.env.FAKE_PI_STREAM_MS || 0);

const { appendFileSync, existsSync, mkdirSync, writeFileSync } = require('node:fs');
const os = require('node:os');
const path = require('node:path');

let buf = '';
let streaming = false;
let sessionFile = null;
let sessionName = null;
let flushed = false;
let msgSeq = 0;
let lastLeaf = null;
let streamTimer = null;

// R03 п.2: an explicit `--mode rpc` WITHOUT `--session` is a NEW session —
// mirror Pi: get_state resolves the future file under the session dir (env
// dir when set, otherwise a tmp bucket). Nothing is written before the first
// message (Pi: _persist gates on _hasConversation). A bare argv (no --mode)
// is the unit-level no-session handshake fixture — it keeps sessionFile
// absent exactly like Pi's `--no-session` handshake.
if (
  process.argv.includes('--mode') &&
  !process.argv.includes('--session') &&
  !process.argv.includes('--no-session') &&
  !process.argv.includes('--version') &&
  !process.argv.includes('--help')
) {
  const dir = process.env.PI_CODING_AGENT_SESSION_DIR || path.join(os.tmpdir(), 'fake-pi-sessions');
  mkdirSync(dir, { recursive: true });
  sessionFile = path.join(dir, `${new Date().toISOString().replace(/[:.]/g, '-')}_fake-session-0001.jsonl`);
}

const send = (obj) => process.stdout.write(`${JSON.stringify(obj)}\n`);
const delay = (fn) => {
  if (STREAM_MS > 0) {
    streamTimer = setTimeout(fn, STREAM_MS);
  } else {
    setImmediate(fn);
  }
};

if (MODE === 'hostile-start') {
  process.stdout.write('this is not json at all\n');
  process.stdout.write(`{"type":"noise","pad":"${'x'.repeat(4096)}"}\n`);
}

if (MODE === 'ext-ui') {
  send({ type: 'extension_ui_request', id: 'ext-notify-1', method: 'notify', message: 'hello from extension' });
  send({ type: 'extension_ui_request', id: 'ext-confirm-1', method: 'confirm', title: 'Proceed?', timeout: 5000 });
}

function streamPrompt(id, message) {
  streaming = true;
  // Mirror of Pi's first flush (session-manager._persist): the user message
  // materializes header + queued session_info name + the entry; appends from
  // there on («keeps the prompt on disk if the first turn never completes»).
  materializePrompt(message);
  send({ id, type: 'response', command: 'prompt', success: true, data: { disposition: 'started' } });
  if (MODE === 'crash-on-prompt') {
    send({ type: 'agent_start' });
    send({ type: 'message_start', message: { role: 'assistant', content: [], timestamp: 1 } });
    setTimeout(() => process.exit(7), 5);
    return;
  }
  const steps = [
    { type: 'agent_start' },
    { type: 'turn_start' },
    { type: 'message_start', message: { role: 'user', content: message, timestamp: 1 } },
    { type: 'message_end', message: { role: 'user', content: message, timestamp: 1 } },
    { type: 'message_start', message: { role: 'assistant', content: [], stopReason: 'pending', timestamp: 2 } },
    { type: 'message_update', assistantMessageEvent: { type: 'text_delta', contentIndex: 0, delta: 'Hello 🌍' } },
    { type: 'message_update', assistantMessageEvent: { type: 'text_delta', contentIndex: 0, delta: ' — done' } },
    { type: 'message_end', message: { role: 'assistant', content: [{ type: 'text', text: 'Hello 🌍 — done' }], stopReason: 'stop', timestamp: 3 } },
    { type: 'turn_end', toolResults: [] },
    { type: 'agent_end', willRetry: false },
    { type: 'agent_settled', aborted: false },
  ];
  let i = 0;
  const next = () => {
    if (!streaming || i >= steps.length) return;
    const step = steps[i];
    i += 1;
    send(step);
    if (step.type === 'message_end' && step.message && step.message.role === 'assistant') {
      appendAssistant(step.message);
    }
    if (step.type === 'agent_settled') streaming = false;
    delay(next);
  };
  delay(next);
}

function materializePrompt(message) {
  // Existing sessions (fixture files opened via switch_session) are never
  // rewritten — they belong to the fixture; only a CREATED session (file does
  // not exist yet) gets Pi's first-flush treatment below.
  if (!sessionFile || existsSync(sessionFile)) return;
  const iso = new Date().toISOString();
  msgSeq += 1;
  const userEntry = {
    type: 'message',
    id: `m${msgSeq}`,
    parentId: lastLeaf,
    timestamp: iso,
    message: { role: 'user', content: message, timestamp: Date.now() },
  };
  if (!flushed) {
    mkdirSync(path.dirname(sessionFile), { recursive: true });
    const lines = [
      JSON.stringify({ type: 'session', version: 3, id: 'fake-session-0001', timestamp: iso, cwd: process.cwd() }),
    ];
    if (sessionName) {
      lines.push(JSON.stringify({ type: 'session_info', id: 'n1', parentId: null, timestamp: iso, name: sessionName }));
    }
    lines.push(JSON.stringify(userEntry));
    writeFileSync(sessionFile, `${lines.join('\n')}\n`);
    flushed = true;
  } else {
    appendFileSync(sessionFile, `${JSON.stringify(userEntry)}\n`);
  }
  lastLeaf = userEntry.id;
}

function appendAssistant(message) {
  if (!flushed || !sessionFile) return;
  msgSeq += 1;
  const text = Array.isArray(message.content)
    ? message.content.map((c) => (typeof c.text === 'string' ? c.text : '')).join('')
    : String(message.content ?? '');
  const entry = {
    type: 'message',
    id: `m${msgSeq}`,
    parentId: lastLeaf,
    timestamp: new Date().toISOString(),
    message: {
      role: 'assistant',
      content: [{ type: 'text', text }],
      api: 'fake',
      provider: 'fake',
      model: 'fake-model',
      usage: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, totalTokens: 0, cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 } },
      stopReason: 'stop',
      timestamp: Date.now(),
    },
  };
  appendFileSync(sessionFile, `${JSON.stringify(entry)}\n`);
  lastLeaf = entry.id;
}

function handle(cmd) {
  switch (cmd.type) {
    case 'get_state':
      send({
        id: cmd.id,
        type: 'response',
        command: 'get_state',
        success: true,
        data: {
          model: { id: 'fake-model', name: 'Fake Model', provider: 'fake' },
          thinkingLevel: 'medium',
          isStreaming: streaming,
          isCompacting: false,
          sessionId: 'fake-session-0001',
          ...(sessionFile !== null ? { sessionFile } : {}),
          messageCount: 4,
          pendingMessageCount: 0,
        },
      });
      return;
    case 'get_session_stats':
      send({ id: cmd.id, type: 'response', command: 'get_session_stats', success: true, data: { sessionId: 'fake-session-0001', totalMessages: 4 } });
      return;
    case 'switch_session': {
      if (MODE === 'switch-fail') {
        send({ id: cmd.id, type: 'response', command: 'switch_session', success: false, error: 'Session file not found' });
        return;
      }
      sessionFile = typeof cmd.sessionPath === 'string' ? cmd.sessionPath : null;
      send({ id: cmd.id, type: 'response', command: 'switch_session', success: true, data: { cancelled: false } });
      return;
    }
    case 'set_session_name': {
      const name = typeof cmd.name === 'string' ? cmd.name.trim() : '';
      if (!name) {
        send({ id: cmd.id, type: 'response', command: 'set_session_name', success: false, error: 'Session name cannot be empty' });
        return;
      }
      sessionName = name; // durable at the first flush, exactly like Pi
      send({ id: cmd.id, type: 'response', command: 'set_session_name', success: true });
      return;
    }
    case 'prompt': {
      if (MODE === 'handled') {
        send({ id: cmd.id, type: 'response', command: 'prompt', success: true, data: { disposition: 'handled' } });
        return;
      }
      if (streaming && !cmd.streamingBehavior) {
        send({
          id: cmd.id,
          type: 'response',
          command: 'prompt',
          success: false,
          error: 'Agent is streaming: specify streamingBehavior',
        });
        return;
      }
      if (MODE === 'hang-prompt') return; // no response, no events
      streamPrompt(cmd.id, String(cmd.message ?? ''));
      return;
    }
    case 'abort': {
      if (streaming) {
        if (streamTimer) clearTimeout(streamTimer);
        streaming = false;
        send({ type: 'agent_settled', aborted: true });
      }
      send({ id: cmd.id, type: 'response', command: 'abort', success: true });
      return;
    }
    default:
      send({ id: cmd.id, type: 'response', command: String(cmd.type), success: false, error: `Unknown command: ${cmd.type}` });
  }
}

process.stdin.setEncoding('utf8');
process.stdin.on('data', (chunk) => {
  buf += chunk;
  let idx;
  while ((idx = buf.indexOf('\n')) >= 0) {
    const line = buf.slice(0, idx);
    buf = buf.slice(idx + 1);
    if (line.trim() === '') continue;
    let cmd;
    try {
      cmd = JSON.parse(line);
    } catch (err) {
      send({ type: 'response', command: 'parse', success: false, error: `Failed to parse command: ${err.message}` });
      continue;
    }
    handle(cmd);
  }
});
process.stdin.on('end', () => {
  if (streamTimer) clearTimeout(streamTimer);
  process.exit(0);
});
process.on('SIGTERM', () => process.exit(0));
process.on('SIGINT', () => process.exit(0));

#!/usr/bin/env node
/**
 * Deterministic Pi RPC fixture — mirrors the installed Pi 1.3.0 protocol
 * (JSONL stdin commands / stdout responses + session events, LF framing,
 * id correlation, agent_settled terminal, abort-waits-idle).
 *
 * Behaviour via FAKE_PI_MODE:
 *   ok (default)      stream a prompt to agent_settled (unicode deltas)
 *   handled           prompt answers disposition=handled (no run, no settled)
 *   hang-prompt       never answer the prompt (deadline/kill tests)
 *   crash-on-prompt   exit(7) mid-run after two records
 *   switch-fail       switch_session answers success:false
 *   ext-ui            emit a fire-and-forget + a blocking dialog at startup
 *   hostile-start     emit garbage + an oversize line before anything else
 * FAKE_PI_STREAM_MS delays each stream step (slow runs for interrupt tests).
 */
'use strict';

// Probe compatibility (mirror of the REAL pi CLI surface used by probePi):
// `pi --version` and `pi --help` answer and exit; any other argv (notably
// `--mode rpc --session …`) enters the RPC loop below.
if (process.argv.includes('--version')) {
  process.stdout.write('1.3.0-fake\n');
  process.exit(0);
}
if (process.argv.includes('--help')) {
  process.stdout.write('Usage: pi\n  --mode <mode>   Output mode: text (default), json, or rpc\n');
  process.exit(0);
}

const MODE = process.env.FAKE_PI_MODE || 'ok';
const STREAM_MS = Number(process.env.FAKE_PI_STREAM_MS || 0);

let buf = '';
let streaming = false;
let sessionFile = null;
{
  const i = process.argv.indexOf('--session');
  if (i > 0 && typeof process.argv[i + 1] === 'string') sessionFile = process.argv[i + 1];
}
let lastEntryId = 'seed';
const { appendFileSync } = require('node:fs');
const appendRow = (row) => {
  if (!sessionFile) return;
  lastEntryId = `fx-${Math.random().toString(36).slice(2, 10)}`;
  try {
    appendFileSync(sessionFile, `${JSON.stringify({ ...row, id: lastEntryId, parentId: lastEntryId === 'seed' ? null : lastEntryId })}\n`);
  } catch {}
};
let streamTimer = null;
// UI21-F2: mutable model/thinking state so get_state reflects real switches.
let currentModel = { id: 'fake-model', name: 'Fake Model', provider: 'fake' };
let currentThinking = 'medium';
const AVAILABLE_MODELS = [
  { provider: 'prov-a', id: 'model-one', name: 'Model One', api: 'openai-completions', reasoning: true, input: ['text'], contextWindow: 200000, maxTokens: 8192, cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 } },
  { provider: 'prov-b', id: 'model-two', name: 'Model Two', api: 'openai-completions', reasoning: false, input: ['text', 'image'], contextWindow: 100000, maxTokens: 4096, cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 } },
];

const send = (obj) => process.stdout.write(`${JSON.stringify(obj)}\n`);
const delay = (fn) => {
  if (STREAM_MS > 0) {
    streamTimer = setTimeout(fn, STREAM_MS);
  } else {
    setImmediate(fn);
  }
};

if (MODE === 'hostile-start') {
  process.stdout.write('this is not json at all\n');
  process.stdout.write(`{"type":"noise","pad":"${'x'.repeat(4096)}"}\n`);
}

if (MODE === 'ext-ui') {
  send({ type: 'extension_ui_request', id: 'ext-notify-1', method: 'notify', message: 'hello from extension' });
  send({ type: 'extension_ui_request', id: 'ext-confirm-1', method: 'confirm', title: 'Proceed?', timeout: 5000 });
}

function streamPrompt(id, message) {
  streaming = true;
  send({ id, type: 'response', command: 'prompt', success: true, data: { disposition: 'started' } });
  if (MODE === 'crash-on-prompt') {
    send({ type: 'agent_start' });
    send({ type: 'message_start', message: { role: 'assistant', content: [], timestamp: 1 } });
    setTimeout(() => process.exit(7), 5);
    return;
  }
  const steps = [
    { type: 'agent_start' },
    { type: 'turn_start' },
    { type: 'message_start', message: { role: 'user', content: message, timestamp: 1 } },
    { type: 'message_end', message: { role: 'user', content: message, timestamp: 1 } },
    { type: 'message_start', message: { role: 'assistant', content: [], stopReason: 'pending', timestamp: 2 } },
    { type: 'message_update', assistantMessageEvent: { type: 'text_delta', contentIndex: 0, delta: 'Hello 🌍' } },
    { type: 'message_update', assistantMessageEvent: { type: 'text_delta', contentIndex: 0, delta: ' — done' } },
    { type: 'message_end', message: { role: 'assistant', content: [{ type: 'text', text: 'Hello 🌍 — done' }], stopReason: 'stop', timestamp: 3 } },
    { type: 'turn_end', toolResults: [] },
    { type: 'agent_end', willRetry: false },
    { type: 'agent_settled', aborted: false },
  ];
  let i = 0;
  const next = () => {
    if (!streaming || i >= steps.length) return;
    const step = steps[i];
    i += 1;
    send(step);
    if (step.type === 'agent_settled') streaming = false;
    delay(next);
  };
  delay(next);
}

function handle(cmd) {
  switch (cmd.type) {
    case 'get_state':
      send({
        id: cmd.id,
        type: 'response',
        command: 'get_state',
        success: true,
        data: {
          model: currentModel,
          thinkingLevel: currentThinking,
          isStreaming: streaming,
          isCompacting: false,
          sessionId: 'fake-session-0001',
          ...(sessionFile !== null ? { sessionFile } : {}),
          messageCount: 4,
          pendingMessageCount: 0,
        },
      });
      return;
    case 'get_session_stats':
      send({ id: cmd.id, type: 'response', command: 'get_session_stats', success: true, data: { sessionId: 'fake-session-0001', totalMessages: 4 } });
      return;
    case 'get_available_models': {
      if (MODE === 'no-models') {
        send({ id: cmd.id, type: 'response', command: 'get_available_models', success: true, data: { models: [] } });
        return;
      }
      send({ id: cmd.id, type: 'response', command: 'get_available_models', success: true, data: { models: AVAILABLE_MODELS } });
      return;
    }
    case 'set_model': {
      const match = AVAILABLE_MODELS.find((m) => m.provider === cmd.provider && m.id === cmd.modelId);
      if (MODE === 'model-fail' || !match) {
        send({ id: cmd.id, type: 'response', command: 'set_model', success: false, error: 'Model not found' });
        return;
      }
      currentModel = MODE === 'model-null'
        ? null // ACK without an actual switch — the bridge must not report success
        : { id: match.id, name: match.name, provider: match.provider };
      if (MODE !== 'model-null') {
        const previousThinking = currentThinking;
        appendRow({ type: 'model_change', timestamp: new Date().toISOString(), provider: match.provider, modelId: match.id });
        // Native Pi 1.4.0: setModel() calls setThinkingLevel(effective) right after
        // the model change, and that appends a second record whenever the
        // effective level differs (e.g. a non-reasoning model forces "off").
        if (match.reasoning === false && previousThinking !== 'off') {
          currentThinking = 'off';
          appendRow({ type: 'thinking_level_change', timestamp: new Date().toISOString(), thinkingLevel: 'off' });
        }
        // race simulation: another writer appends while our switch is in flight
        if (MODE === 'switch-race') appendRow({ type: 'message', timestamp: new Date().toISOString(), message: { role: 'user', content: 'cli wrote here' } });
      }
      send({ id: cmd.id, type: 'response', command: 'set_model', success: true, data: {} });
      return;
    }
    case 'get_available_thinking_levels': {
      const levels = MODE === 'no-thinking' ? ['off'] : ['off', 'high'];
      send({ id: cmd.id, type: 'response', command: 'get_available_thinking_levels', success: true, data: { levels } });
      return;
    }
    case 'set_thinking_level': {
      if (MODE === 'thinking-fail') {
        send({ id: cmd.id, type: 'response', command: 'set_thinking_level', success: false, error: 'Unsupported thinking level' });
        return;
      }
      currentThinking = MODE === 'thinking-null' ? null : String(cmd.level);
      if (MODE !== 'thinking-null') {
        appendRow({ type: 'thinking_level_change', timestamp: new Date().toISOString(), thinkingLevel: String(cmd.level) });
      }
      send({ id: cmd.id, type: 'response', command: 'set_thinking_level', success: true, data: {} });
      return;
    }
    case 'switch_session': {
      if (MODE === 'switch-fail') {
        send({ id: cmd.id, type: 'response', command: 'switch_session', success: false, error: 'Session file not found' });
        return;
      }
      sessionFile = typeof cmd.sessionPath === 'string' ? cmd.sessionPath : null;
      send({ id: cmd.id, type: 'response', command: 'switch_session', success: true, data: { cancelled: false } });
      return;
    }
    case 'prompt': {
      if (MODE === 'handled') {
        send({ id: cmd.id, type: 'response', command: 'prompt', success: true, data: { disposition: 'handled' } });
        return;
      }
      if (streaming && !cmd.streamingBehavior) {
        send({
          id: cmd.id,
          type: 'response',
          command: 'prompt',
          success: false,
          error: 'Agent is streaming: specify streamingBehavior',
        });
        return;
      }
      if (MODE === 'hang-prompt') return; // no response, no events
      streamPrompt(cmd.id, String(cmd.message ?? ''));
      return;
    }
    case 'abort': {
      if (streaming) {
        if (streamTimer) clearTimeout(streamTimer);
        streaming = false;
        send({ type: 'agent_settled', aborted: true });
      }
      send({ id: cmd.id, type: 'response', command: 'abort', success: true });
      return;
    }
    default:
      send({ id: cmd.id, type: 'response', command: String(cmd.type), success: false, error: `Unknown command: ${cmd.type}` });
  }
}

process.stdin.setEncoding('utf8');
process.stdin.on('data', (chunk) => {
  buf += chunk;
  let idx;
  while ((idx = buf.indexOf('\n')) >= 0) {
    const line = buf.slice(0, idx);
    buf = buf.slice(idx + 1);
    if (line.trim() === '') continue;
    let cmd;
    try {
      cmd = JSON.parse(line);
    } catch (err) {
      send({ type: 'response', command: 'parse', success: false, error: `Failed to parse command: ${err.message}` });
      continue;
    }
    handle(cmd);
  }
});
process.stdin.on('end', () => {
  if (streamTimer) clearTimeout(streamTimer);
  process.exit(0);
});
process.on('SIGTERM', () => process.exit(0));
process.on('SIGINT', () => process.exit(0));
